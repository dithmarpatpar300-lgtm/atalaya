test("traduce cada patrón completo y conserva lo desconocido", () => {
  fijarIdioma("en");
  try {
    assert.equal(ejemplos.length, PATRONES_SERVIDOR.length);
    ejemplos.forEach((texto, i) => {
      assert.equal(PATRONES_SERVIDOR.findIndex(([patron]) => patron.test(texto)), i, texto);
      assert.notEqual(tServidor(texto), texto);
    });
    assert.equal(tServidor("la primera línea dice 40 % y los paquetes dan 41,5 %"), "the first line says 40% and the packages yield 41.5%");
    assert.equal(tServidor("Texto escrito por una persona"), "Texto escrito por una persona");
  } finally {
    fijarIdioma("es");
  }
});

test("en español conserva todos los textos", () => {
  fijarIdioma("es");
  for (const texto of ejemplos) assert.equal(tServidor(texto), texto);
});
